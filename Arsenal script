table.insert(Connections, RunService.RenderStepped:Connect(function()
	SafeCall(function()
		if LocalPlayer.Character then
			local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.WalkSpeed ~= Config.WalkSpeed then
				hum.WalkSpeed = Config.WalkSpeed
			end
		end

		if FOVCircle then
			FOVCircle.Visible = Config.ShowFOV
			FOVCircle.Size = UDim2.fromOffset(Config.FOV * 2, Config.FOV * 2)
		end

		if Config.AntiAim then
			local char = LocalPlayer.Character
			if char then
				local root = char:FindFirstChild("HumanoidRootPart")
				if root then
					SpinAngle = SpinAngle + Config.AntiAimSpeed
					root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, math.rad(SpinAngle), 0)
				end
			end
		end

		if Config.AimAssist then
			local target = GetClosestEnemy()
			if target then
				local current = Camera.CFrame
				local goal = CFrame.lookAt(current.Position, target.Position)
				if Config.Smooth then
					Camera.CFrame = current:Lerp(goal, Config.Smoothness)
				else
					Camera.CFrame = goal
				end
			end
		end
	end)
end))

