	for _, v in ipairs(HiddenFolder:GetChildren()) do
		if v:IsA("BillboardGui") or v:IsA("Highlight") then v:Destroy() end
	end
end

local function CreateESP(player)
	if not player.Character then return end
	local char = player.Character
	local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not root or not hum then return end

	local bb = Instance.new("BillboardGui")
	bb.Name = tostring(math.random(10000,99999))
	bb.Adornee = root
	bb.Size = UDim2.new(0, 220, 0, 55)
	bb.StudsOffset = Vector3.new(0, 3.4, 0)
	bb.AlwaysOnTop = true
	bb.Parent = HiddenFolder

	if Config.Names or Config.Health or Config.Distance then
		local txt = Instance.new("TextLabel")
		txt.Size = UDim2.new(1, 0, 1, 0)
		txt.BackgroundTransparency = 1
		txt.TextColor3 = Color3.fromRGB(255, 40, 40)
		txt.Font = Enum.Font.GothamBold
		txt.TextSize = 14
		txt.TextStrokeTransparency = 0.2
		txt.Parent = bb

		local function upd()
			if not char or not hum or hum.Health <= 0 then bb:Destroy() return end
			local parts = {}
			if Config.Names then table.insert(parts, player.Name) end
			if Config.Health then table.insert(parts, math.floor(hum.Health) .. " HP") end
			if Config.Distance and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
				local d = (root.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
				table.insert(parts, math.floor(d) .. "m")
			end
			txt.Text = table.concat(parts, " | ")
		end
		upd()
		table.insert(Connections, hum.HealthChanged:Connect(upd))
	end

	if Config.Boxes then
		local hl = Instance.new("Highlight")
		hl.Name = tostring(math.random(10000,99999))
		hl.Adornee = char
		hl.FillColor = Color3.fromRGB(255, 20, 20)
		hl.OutlineColor = Color3.fromRGB(255, 255, 255)
		hl.FillTransparency = 0.5
		hl.OutlineTransparency = 0
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Parent = HiddenFolder
	end
end

local function UpdateESP()
	ClearESP()
	if not Config.ESP then return end
	for _, plr in ipairs(Players:GetPlayers()) do
		if IsValidEnemy(plr) then CreateESP(plr) end
	end
end

