local function ApplyRapidFire(state)
	if RapidFireConnection then
		RapidFireConnection:Disconnect()
		RapidFireConnection = nil
	end
	if not state then return end

	RapidFireConnection = RunService.Heartbeat:Connect(function()
		SafeCall(function()
			local char = LocalPlayer.Character
			if not char then return end
			local tool = char:FindFirstChildOfClass("Tool")
			if not tool then return end

			for _, obj in ipairs(tool:GetDescendants()) do
				if obj:IsA("NumberValue") or obj:IsA("IntValue") then
					local n = string.lower(obj.Name)
					if n:find("cooldown") or n:find("delay") or n:find("firerate") or n:find("rate") or n:find("debounce") or n:find("reload") or n:find("fire") then
						obj.Value = 0
					end
				elseif obj:IsA("BoolValue") then
					local n = string.lower(obj.Name)
					if n:find("debounce") or n:find("canfire") or n:find("ready") then
						obj.Value = true
					end
				end
			end

			pcall(function()
				tool:SetAttribute("Cooldown", 0)
				tool:SetAttribute("FireRate", 0.001)
				tool:SetAttribute("Delay", 0)
				tool:SetAttribute("Debounce", false)
				tool:SetAttribute("CanFire", true)
				tool:SetAttribute("Ready", true)
			end)

			for _, v in pairs(getgc(true)) do
				if typeof(v) == "table" then
					if rawget(v, "FireRate") then rawset(v, "FireRate", 0.001) end
					if rawget(v, "Cooldown") then rawset(v, "Cooldown", 0) end
					if rawget(v, "Delay") then rawset(v, "Delay", 0) end
					if rawget(v, "Debounce") then rawset(v, "Debounce", false) end
					if rawget(v, "CanFire") then rawset(v, "CanFire", true) end
					if rawget(v, "Ready") then rawset(v, "Ready", true) end
					if rawget(v, "FireDelay") then rawset(v, "FireDelay", 0) end
				end
			end

			if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
				if tick() - LastFire > 0.015 then
					LastFire = tick()
					ForceFire()
				end
			end
		end)
	end)
end

