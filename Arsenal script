local function NukeVisuals(obj)
	if not obj or not obj.Parent then return end
	local n = string.lower(tostring(obj.Name))
	if n:find("bullet") or n:find("projectile") or n:find("shot") or n:find("pellet") or n:find("tracer") or n:find("muzzle") or n:find("shell") then
		if obj:IsA("BasePart") or obj:IsA("MeshPart") then
			obj.Transparency = 1
			obj.CanCollide = false
			obj.CastShadow = false
		end
		pcall(function() obj:Destroy() end)
	end
	if obj:IsA("Texture") or obj:IsA("Decal") then
		obj.Transparency = 1
		pcall(function() obj:Destroy() end)
	elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
		obj.Enabled = false
		pcall(function() obj:Destroy() end)
	elseif obj:IsA("MeshPart") or obj:IsA("Part") then
		obj.Material = Enum.Material.SmoothPlastic
		obj.CastShadow = false
	end
end

local function ApplyFPSBoost(state)
	if state then
		SafeCall(function()
			settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
			UserSettings():GetService("UserGameSettings").SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
			Lighting.GlobalShadows = false
			Lighting.FogEnd = 9e9
			Lighting.Brightness = 1
			for _, o in pairs(workspace:GetDescendants()) do NukeVisuals(o) end
			for _, o in pairs(Lighting:GetDescendants()) do NukeVisuals(o) end
		end)
		if BulletConnection then BulletConnection:Disconnect() end
		BulletConnection = workspace.DescendantAdded:Connect(function(o)
			task.defer(function() NukeVisuals(o) end)
		end)
	else
		if BulletConnection then BulletConnection:Disconnect() BulletConnection = nil end
	end
end

