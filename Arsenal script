			FOVCircle.Size = UDim2.fromOffset(Config.FOV * 2, Config.FOV * 2)
		end

		if Config.AntiAim then
			local char = LocalPlayer.Character
			if char then
				local root = char:FindFirstChild("HumanoidRootPart")
				local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
				SpinAngle = SpinAngle + Config.AntiAimSpeed
				if root then
					root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, math.rad(SpinAngle), 0)
				end
				if torso then
					torso.CFrame = CFrame.new(torso.Position) * CFrame.Angles(0, math.rad(SpinAngle * 1.6), 0)
				end
			end
		end

		if Config.AimAssist or Config.SilentAim then
			local target
			if Config.Ragebot then
				if CurrentTarget and CurrentTarget.Parent then
					target = CurrentTarget
				else
					target = GetClosestEnemy(true)
				end
			else
				target = GetClosestEnemy(Config.SilentAim)
			end

			if target then
				if Config.SilentAim then
					Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, target.Position)
				elseif Config.AimAssist then
					if Config.Ragebot then
						Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, target.Position)
					else
						Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, target.Position), 0.92)
					end
				end
			end
		end
	end)
end))

task.spawn(function()
	while task.wait(0.25) do
		if Config.ESP then SafeCall(UpdateESP) end
	end
end)

table.insert(Connections, LocalPlayer.CharacterAdded:Connect(function(char)
	task.wait(0.2)
	local hum = char:WaitForChild("Humanoid", 5)
	if hum then hum.WalkSpeed = Config.WalkSpeed end
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") then p.CanCollide = not Config.Noclip end
	end
end))

ApplyBubbleShots(true)
Rayfield:LoadConfiguration()
