local function NukeVisuals(obj)
	if not obj or not obj.Parent then return end
	local n = string.lower(tostring(obj.Name))
	if n:find("bullet") or n:find("projectile") or n:find("shot") or n:find("pellet") or n:find("tracer") or n:find("muzzle") or n:find("shell") then
		if obj:IsA("BasePart") or obj:IsA("MeshPart") then
			obj.Transparency = 1
			obj.CanCollide = false
			obj.CastShadow = false
		end
		pcall(function() obj:Destroy() end)
	end
	if obj:IsA("Texture") or obj:IsA("Decal") then
		obj.Transparency = 1
		pcall(function() obj:Destroy() end)
	elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
		obj.Enabled = false
		pcall(function() obj:Destroy() end)
	elseif obj:IsA("MeshPart") or obj:IsA("Part") then
		obj.Material = Enum.Material.SmoothPlastic
		obj.CastShadow = false
	end
end

local function ApplyFPSBoost(state)
	if state then
		SafeCall(function()
			settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
			UserSettings():GetService("UserGameSettings").SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
			Lighting.GlobalShadows = false
			Lighting.FogEnd = 9e9
			Lighting.Brightness = 1
			for _,o in pairs(workspace:GetDescendants()) do NukeVisuals(o) end
			for _,o in pairs(Lighting:GetDescendants()) do NukeVisuals(o) end
		end)
		if BulletConnection then BulletConnection:Disconnect() end
		BulletConnection = workspace.DescendantAdded:Connect(function(o)
			task.defer(function() NukeVisuals(o) end)
		end)
	else
		if BulletConnection then BulletConnection:Disconnect() BulletConnection = nil end
	end
end

local function ApplyBubbleShots(state)
	if state then
		if SoundConnection then SoundConnection:Disconnect() end
		SoundConnection = workspace.DescendantAdded:Connect(function(o)
			if o:IsA("Sound") then
				task.defer(function()
					local n = string.lower(o.Name)
					if n:find("gun") or n:find("shot") or n:find("fire") or n:find("bullet") or n:find("shoot") or n:find("weapon") then
						o.SoundId = BUBBLE_SOUND
						o.Volume = 1.6
						o.PlaybackSpeed = 1.05 + math.random()*0.35
					end
				end)
			end
		end)
	else
		if SoundConnection then SoundConnection:Disconnect() SoundConnection = nil end
	end
end

local function ApplySkinChanger()
	SafeCall(function()
		local function process(container)
			for _,tool in ipairs(container:GetChildren()) do
				if tool:IsA("Tool") then
					for _,v in ipairs(tool:GetDescendants()) do
						if v:IsA("MeshPart") or v:IsA("Part") then
							v.Material = Enum.Material.SmoothPlastic
							v.Color = Color3.fromRGB(math.random(50,255),math.random(50,255),math.random(50,255))
						end
						if v:IsA("SpecialMesh") then
							v.TextureId = ""
						end
						if v:IsA("Decal") or v:IsA("Texture") then
							v.Transparency = 0
						end
						if string.find(string.lower(v.Name),"lock") or string.find(string.lower(v.Name),"owned") then
							if v:IsA("BoolValue") then v.Value = true end
							if v:IsA("StringValue") then v.Value = "Unlocked" end
						end
					end
				end
			end
		end
		if LocalPlayer.Character then process(LocalPlayer.Character) end
		if LocalPlayer:FindFirstChild("Backpack") then process(LocalPlayer.Backpack) end
	end)
end

