		if Config.AntiAim then
			local char = LocalPlayer.Character
			if char then
				local root = char:FindFirstChild("HumanoidRootPart")
				local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
				SpinAngle = SpinAngle + Config.AntiAimSpeed
				if root then
					root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0,math.rad(SpinAngle),0)
				end
				if torso then
					torso.CFrame = CFrame.new(torso.Position) * CFrame.Angles(0,math.rad(SpinAngle*1.3),0)
				end
			end
		end

		if Config.AimAssist then
			local target
			if Config.Ragebot and CurrentTarget and CurrentTarget.Parent then
				target = CurrentTarget
			else
				target = GetClosestEnemy(false)
			end
			if target then
				local goal = CFrame.lookAt(Camera.CFrame.Position,target.Position)
				if Config.Ragebot then
					Camera.CFrame = goal
				else
					Camera.CFrame = Camera.CFrame:Lerp(goal,0.92)
				end
			end
		end

		if Config.SkinChanger then
			ApplySkinChanger()
		end
	end)
end))

