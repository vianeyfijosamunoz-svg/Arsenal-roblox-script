local function RefreshConfigList()
	for _, child in ipairs(ConfigList:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	pcall(function()
		if isfolder and isfolder(ConfigsFolder) then
			for _, file in ipairs(listfiles(ConfigsFolder)) do
				local name = file:match("([^/\\]+)%.json$")
				if name then SavedConfigs[name] = SavedConfigs[name] or true end
			end
		end
	end)
	local count = 0
	for name, _ in pairs(SavedConfigs) do
		count += 1
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, -8, 0, 28)
		btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
		btn.Text = name
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.Font = Enum.Font.Gotham
		btn.TextSize = 13
		btn.Parent = ConfigList
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 4)
		c.Parent = btn
		btn.MouseButton1Click:Connect(function()
			LoadConfig(name)
		end)
	end
	ConfigList.CanvasSize = UDim2.new(0, 0, 0, count * 32)
end

local function SaveConfig()
	local name = ConfigNameBox.Text
	if name == "" then return end
	SavedConfigs[name] = {
		AimAssist = Config.AimAssist,
		ESP = Config.ESP,
		Noclip = Config.Noclip,
		WalkSpeed = Config.WalkSpeed,
		FOV = Config.FOV
	}
	pcall(function()
		if makefolder and not isfolder(ConfigsFolder) then makefolder(ConfigsFolder) end
		if writefile then
			writefile(ConfigsFolder .. "/" .. name .. ".json", HttpService:JSONEncode(SavedConfigs[name]))
		end
	end)
	RefreshConfigList()
end

function LoadConfig(name)
	local data = type(SavedConfigs[name]) == "table" and SavedConfigs[name] or nil
	if not data then
		pcall(function()
			if readfile then
				data = HttpService:JSONDecode(readfile(ConfigsFolder .. "/" .. name .. ".json"))
				SavedConfigs[name] = data
			end
		end)
	end
	if data then
		Config.AimAssist = data.AimAssist or false
		Config.ESP = data.ESP or false
		Config.Noclip = data.Noclip or false
		Config.WalkSpeed = data.WalkSpeed or 16
		Config.FOV = data.FOV or 120
		FOVLabel.Text = "FOV: " .. Config.FOV
		SpeedLabel.Text = "WalkSpeed: " .. Config.WalkSpeed
		if FOVCircle then FOVCircle.Size = UDim2.fromOffset(Config.FOV * 2, Config.FOV * 2) end
		if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
			LocalPlayer.Character.Humanoid.WalkSpeed = Config.WalkSpeed
		end
	end
end

local function DeleteConfig(name)
	SavedConfigs[name] = nil
	pcall(function()
		if delfile then delfile(ConfigsFolder .. "/" .. name .. ".json") end
	end)
	RefreshConfigList()
end

