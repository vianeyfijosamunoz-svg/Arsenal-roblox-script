RunService.RenderStepped:Connect(function()
	if LocalPlayer.Character then
		local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.WalkSpeed = Config.WalkSpeed
		end
	end

	if FOVCircle then
		FOVCircle.Visible = Config.ShowFOV
		FOVCircle.Size = UDim2.fromOffset(Config.FOV * 2, Config.FOV * 2)
	end

	if Config.AntiRecoil and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
		Camera.CFrame = Camera.CFrame * CFrame.Angles(math.rad(-Config.AntiRecoilStrength), 0, 0)
	end

	if Config.AimAssist then
		local target = GetClosestEnemy()
		if target then
			local current = Camera.CFrame
			local goal = CFrame.lookAt(current.Position, target.Position)
			if Config.Smooth then
				Camera.CFrame = current:Lerp(goal, Config.Smoothness)
			else
				Camera.CFrame = goal
			end

			if Config.Triggerbot and (tick() - lastClick) >= CLICK_COOLDOWN then
				if mouse1click then
					mouse1click()
					lastClick = tick()
				end
			end
		end
	end
end)

